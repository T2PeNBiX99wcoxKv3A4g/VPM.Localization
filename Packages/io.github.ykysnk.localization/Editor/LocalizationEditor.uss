/* Shared look for the Localization inspectors. Theme-neutral: only translucent greys, so light and dark both work. */

.localization-root {
    flex-grow: 1;
    padding: 6px 6px 8px 6px;
}

.localization-field {
    flex-direction: column;
    margin: 0 0 6px 0;
}

.localization-search {
    margin: 0 0 4px 0;
}

/* Format conversion section under the list. */
.convert-section {
    margin: 6px 0 0 0;
}

.convert-row {
    flex-direction: row;
    align-items: center;
    margin: 2px 0;
}

.convert-field {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0 6px 0 0;
}

.convert-button {
    min-width: 84px;
    margin: 0 0 0 4px;
    padding: 1px 8px;
    font-size: 11px;
}

.convert-hint {
    margin: 4px 0 0 0;
    font-size: 10px;
    color: rgba(128, 128, 128, 0.9);
}

/* Header above the translate list: title, count pill, add/remove. */
.list-header {
    flex-direction: row;
    align-items: center;
    margin: 2px 0 3px 0;
    padding: 0 2px;
}

.list-header__title {
    -unity-font-style: bold;
}

.list-header__count {
    margin-left: 6px;
    padding: 0 6px;
    font-size: 10px;
    background-color: rgba(128, 128, 128, 0.22);
    border-radius: 8px;
}

.list-header__spacer {
    flex-grow: 1;
}

.list-header__button {
    width: 24px;
    height: 20px;
    margin: 0 0 0 4px;
    padding: 0;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.list-header__button:disabled {
    opacity: 0.4;
}

.localization-list {
    flex-grow: 1;
    min-height: 140px;
    max-height: 480px;
    margin: 0;
}

/* One translate entry inside the ListView. */
.translate-root {
    padding: 6px 6px 8px 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(128, 128, 128, 0.25);
}

.translate-root:hover {
    background-color: rgba(128, 128, 128, 0.07);
}

.translate-field {
    flex-direction: column;
    margin: 0 0 4px 0;
}

.translate-textarea {
    min-height: 54px;
    white-space: normal;
}

/* Hidden for entries without a tooltip; shown by the drawer. */
.translate-tooltip-field {
    min-height: 44px;
}

.translate-buttons {
    flex-direction: row;
    align-items: center;
    margin: 4px 0 0 0;
}

.translate-buttons__spacer {
    flex-grow: 1;
}

.translate-button {
    min-width: 72px;
    margin: 0 0 0 6px;
    padding: 1px 10px;
    font-size: 11px;
}

.translate-tooltip-toggle {
    align-self: flex-start;
    margin: 0 0 4px 0;
    font-size: 11px;
}

.translate-tooltip-toggle .unity-base-field__input {
    flex-grow: 0;
    flex-shrink: 0;
}

.translate-tooltip-toggle .unity-base-field__label {
    flex-grow: 0;
    margin-left: 4px;
    margin-right: 0;
}

.translate-suffix-field {
    max-width: 240px;
}
