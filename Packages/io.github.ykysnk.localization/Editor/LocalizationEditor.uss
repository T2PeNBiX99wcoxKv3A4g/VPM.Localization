/*
 * Localization inspectors.
 * Same visual language as the toolkit windows: translucent greys plus one accent, rounded cards and a flat button
 * set, so the inspector reads the same in the light and the dark editor theme.
 */

.localization-root {
    flex-grow: 1;
    padding: 8px 8px 10px 8px;
}

/* ---------- cards ---------- */

.loc-card {
    padding: 10px;
    margin: 0 0 8px 0;
    background-color: rgba(128, 128, 128, 0.07);
    border-width: 1px;
    border-color: rgba(128, 128, 128, 0.22);
    border-radius: 6px;
}

/* ---------- fields ---------- */

.localization-field {
    flex-direction: column;
    margin: 0 0 6px 0;
}

/* The display name and the language picker share one line; the id keeps the full width above them. */
.loc-row {
    flex-direction: row;
    align-items: flex-end;
}

.loc-row__field {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 140px;
    margin: 0 8px 0 0;
}

/* The language picker is appended to this slot by the editor. */
.loc-language {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 140px;
}

/* Inputs share the card radius, so they do not look like sharp holes punched in it. */
.localization-root .unity-base-text-field__input,
.localization-root .unity-base-popup-field__input,
.localization-root .unity-object-field__input {
    border-radius: 4px;
}

/* ---------- buttons ---------- */

.convert-button,
.convert-pick,
.translate-button,
.list-header__button {
    background-image: none;
    background-color: rgba(128, 128, 128, 0.16);
    border-width: 1px;
    border-color: rgba(128, 128, 128, 0.45);
    border-radius: 4px;
}

.convert-button:hover,
.convert-pick:hover,
.translate-button:hover,
.list-header__button:hover {
    background-color: rgba(76, 141, 255, 0.24);
    border-color: rgba(76, 141, 255, 0.85);
}

.convert-button:active,
.convert-pick:active,
.translate-button:active,
.list-header__button:active {
    background-color: rgba(76, 141, 255, 0.34);
}

/* The one action that creates something is the only filled button in the inspector. */
.list-header__button--primary {
    color: rgb(255, 255, 255);
    background-color: rgb(76, 141, 255);
    border-color: rgb(60, 122, 238);
}

.list-header__button--primary:hover {
    background-color: rgb(94, 155, 255);
    border-color: rgb(94, 155, 255);
}

.list-header__button--primary:active {
    background-color: rgb(66, 126, 235);
}

.list-header__button:disabled {
    opacity: 0.4;
}

/* ---------- search ---------- */

.localization-search {
    /* The toolbar search field ships with a fixed width and a plain dark box; let it fill the toolbar row instead. */
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 120px;
    width: auto;
    min-height: 20px;
    margin: 0 6px 0 8px;
    background-color: rgba(128, 128, 128, 0.10);
    border-width: 1px;
    border-color: rgba(128, 128, 128, 0.28);
    border-radius: 4px;
}

.localization-search .unity-base-text-field__input {
    background-color: transparent;
    border-width: 0;
}

/* ---------- format conversion ---------- */

/* The foldout is the card's heading: a tinted band with the accent arrow, and the fields below it. */
.convert-section {
    margin: 0;
}

.convert-section .unity-foldout__toggle {
    margin: 0;
    flex-grow: 1;
}

.convert-section .unity-foldout__input {
    flex-grow: 1;
    min-height: 22px;
    padding: 2px 6px;
    background-color: rgba(76, 141, 255, 0.10);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.convert-section .unity-foldout__input:hover {
    background-color: rgba(76, 141, 255, 0.18);
}

.convert-section .unity-foldout__checkmark {
    -unity-background-image-tint-color: rgb(120, 165, 255);
}

.convert-section .unity-foldout__text {
    margin-left: 2px;
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(120, 165, 255);
}

/* The fields belong to the card, not to the foldout's default indent. */
.convert-section .unity-foldout__content {
    margin: 6px 0 0 0;
    padding: 0 2px;
}

.convert-row {
    flex-direction: row;
    align-items: center;
    margin: 2px 0;
}

.convert-field {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0;
}

/* "JSON ファイル" is short; a fixed label width leaves the value field room for "None (Object)". */
.convert-field .unity-base-field__label {
    flex-basis: 100px;
    min-width: 100px;
}

.convert-actions {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-end;
    margin: 2px 0 0 0;
    padding-right: 4px;
}

.convert-button {
    min-width: 84px;
    margin: 0 0 0 4px;
    padding: 1px 8px;
    font-size: 11px;
}

.convert-pick {
    width: 28px;
    min-width: 28px;
    margin: 0 0 0 4px;
    padding: 0;
    font-size: 13px;
    -unity-text-align: middle-center;
}

.convert-hint {
    margin: 4px 0 0 0;
    font-size: 10px;
    color: rgba(128, 128, 128, 0.9);
    white-space: normal;
}

/* ---------- translation list ---------- */

/* Header band of the list: title, count pill, add/remove. */
.list-header {
    flex-direction: row;
    align-items: center;
    margin: 0;
    padding: 4px 6px;
    background-color: rgba(76, 141, 255, 0.10);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(76, 141, 255, 0.35);
}

.list-header__title {
    flex-shrink: 0;
    -unity-font-style: bold;
    color: rgb(120, 165, 255);
}

.list-header__count {
    margin-left: 8px;
    padding: 0 7px;
    font-size: 10px;
    color: rgb(255, 255, 255);
    background-color: rgb(76, 141, 255);
    border-radius: 8px;
}

.list-header__spacer {
    flex-grow: 1;
}

.list-header__button {
    width: 24px;
    height: 20px;
    margin: 0 0 0 4px;
    padding: 0;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* The editor sizes this list to the height the inspector shows; 420 is only the first-layout value. */
.localization-list {
    height: 420px;
    min-height: 140px;
    margin: 0;
    border-top-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
}

.localization-list .unity-collection-view__item--selected,
.localization-list .unity-list-view__item--selected {
    background-color: rgba(76, 141, 255, 0.22);
}

/* One translate entry inside the ListView. */
.translate-root {
    padding: 6px 8px 8px 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(128, 128, 128, 0.20);
}

.translate-root:hover {
    background-color: rgba(76, 141, 255, 0.07);
}

.translate-field {
    flex-direction: column;
    margin: 0 0 4px 0;
}

.translate-textarea {
    min-height: 44px;
    white-space: normal;
}

/* Hidden for entries without a tooltip; shown by the drawer. */
.translate-tooltip-field {
    min-height: 40px;
}

.translate-buttons {
    flex-direction: row;
    align-items: center;
    margin: 4px 0 2px 0;
    padding: 2px 6px;
    background-color: rgba(128, 128, 128, 0.06);
    border-radius: 4px;
}

.translate-buttons__spacer {
    flex-grow: 1;
}

.translate-button {
    min-width: 72px;
    margin: 0 0 0 6px;
    padding: 1px 10px;
    font-size: 11px;
}

.translate-tooltip-toggle {
    align-self: center;
    margin: 0;
    font-size: 11px;
}

.translate-tooltip-toggle .unity-base-field__input {
    flex-grow: 0;
    flex-shrink: 0;
}

.translate-tooltip-toggle .unity-base-field__label {
    flex-grow: 0;
    margin-left: 4px;
    margin-right: 0;
}

.translate-suffix-field {
    max-width: 240px;
}
