<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="True">
    <Style src="project://database/Packages/io.github.ykysnk.localization/Editor/LocalizationEditor.uss?fileID=7433441132597879392&amp;guid=920b155e5fa592c409d6423608f6b326&amp;type=3#LocalizationEditor"/>
    <ui:VisualElement class="translate-root">
        <ui:TextField picking-mode="Ignore" label="label.basic_translate.key" name="key" binding-path="key"
                      class="translate-field"/>
        <ui:TextField picking-mode="Ignore" label="label.basic_translate.translate" name="translate" multiline="true"
                      binding-path="translate" class="translate-field translate-textarea"/>
        <ui:Toggle name="useTooltip" label="label.basic_translate.use_tooltip" binding-path="useTooltip"
                   class="translate-tooltip-toggle" tooltip="Store and show a tooltip for this entry"/>
        <ui:TextField picking-mode="Ignore" label="label.basic_translate.tooltip_suffix" name="tooltipSuffix"
                      binding-path="tooltipSuffix" class="translate-field translate-suffix-field"/>
        <ui:TextField picking-mode="Ignore" label="label.basic_translate.tooltip" name="tooltip" multiline="true"
                      binding-path="tooltip" class="translate-field translate-textarea translate-tooltip-field"/>
        <ui:VisualElement class="translate-buttons">
            <ui:VisualElement class="translate-buttons__spacer"/>
            <ui:Button text="label.basic_translate.copy" name="copy" class="translate-button"/>
            <ui:Button text="label.basic_translate.paste" name="paste" class="translate-button"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
